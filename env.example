# ---------------------------------------------------------------------------
# Haumex Labs Inc. AI Voice Caller - backend configuration
# Copy to backend/.env and fill in real values. NEVER commit the real .env.
# OpenRouter is the ONLY AI provider: one key covers answers, speech-to-text
# and the assistant's voice. Secrets live only on the backend.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Transcripts are customer data. Keep this false unless debugging locally.
LOG_TRANSCRIPTS=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required to call POST /api/knowledge/ingest (header: X-Admin-Key).
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Company / assistant ---------------------------------------------------
COMPANY_NAME=Haumex Labs Inc.
COMPANY_SPOKEN_NAME=Haumex Labs
ASSISTANT_GREETING=Hello! Thank you for calling {company_spoken_name}. I'm the company's virtual assistant. How can I help you today?

# --- OpenRouter ----------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_TITLE=Haumex Labs Inc. AI Voice Caller

# Answers: any chat model ID from https://openrouter.ai/models
OPENROUTER_MODEL=
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=350

# Speech-to-text: an OpenRouter model whose INPUT modalities include "audio"
# (on openrouter.ai/models, filter Input Modalities -> Audio).
STT_PROVIDER=openrouter
STT_MODEL=
STT_LANGUAGE=en

# Assistant voice: an OpenRouter model whose OUTPUT modalities include "audio"
# (filter Output Modalities -> Audio). TTS_VOICE must be a voice that model
# offers; the model page lists them. Audio is 16-bit PCM at TTS_SAMPLE_RATE.
TTS_PROVIDER=openrouter
TTS_MODEL=
TTS_VOICE=alloy
TTS_SAMPLE_RATE=24000
TTS_INSTRUCTIONS=Speak warmly and naturally, like a friendly company receptionist on the phone.

# --- PDF search (runs locally, no account or API key) ------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Audio / turn-taking -------------------------------------------------------
AUDIO_SAMPLE_RATE=16000
AUDIO_FRAME_MS=20
VAD_SPEECH_THRESHOLD_DB=-45
VAD_BARGE_IN_THRESHOLD_DB=-35
VAD_MIN_SPEECH_MS=160
VAD_BARGE_IN_MIN_SPEECH_MS=320
VAD_SILENCE_MS=750
VAD_PREROLL_MS=300
VAD_MAX_UTTERANCE_SECONDS=30

# --- Knowledge base ------------------------------------------------------------
KNOWLEDGE_DIRECTORY=knowledge/pdfs
VECTOR_STORE_PATH=data/vector_store
CHROMA_COLLECTION=haumex_knowledge
# Text chunk size in characters (CHUNK_SIZE is accepted as an alias).
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8
RETRIEVAL_MAX_CHUNKS=4
RETRIEVAL_MIN_SCORE=0.30
MAX_CONTEXT_CHARS=6000
MAX_PDF_SIZE_MB=50
AUTO_INGEST_ON_STARTUP=true
# Seconds between checks for new/changed PDFs. 0 disables the watcher.
KNOWLEDGE_WATCH_INTERVAL_SECONDS=60

# --- Calls -------------------------------------------------------------------
MAX_CONCURRENT_CALLS=20
MAX_CALL_DURATION_SECONDS=900
CALL_SETUP_TIMEOUT_SECONDS=60
